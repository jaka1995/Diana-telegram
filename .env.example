# Secrets for the Supabase Edge Functions.
# Set them with:  supabase secrets set --env-file ./.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically — do NOT set them.)

# From @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Any long random string. Used as Telegram's setWebhook secret_token.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Any long random string. Must match the Bearer token in the pg_cron job.
CRON_SECRET=change-me-to-another-long-random-string

# The shared promo code shown to every user.
PROMO_CODE=Freeaba60kz

# Store links shown in the instruction step.
IOS_URL=https://apps.apple.com/app/flymind
ANDROID_URL=https://play.google.com/store/apps/details?id=com.flymind

# Your Telegram numeric id — receives churn alerts and can use /stats.
ADMIN_CHAT_ID=0

# Timezone used for day boundaries / streaks.
BOT_TZ=Asia/Almaty
